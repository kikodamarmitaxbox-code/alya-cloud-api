# Escolha uma das opcoes abaixo.
#
# Opcao 1: OpenRouter
# Crie uma chave em https://openrouter.ai/keys
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=cole_sua_chave_aqui
OPENROUTER_MODEL=openrouter/free
# Roteamento inteligente por tarefa. Use "preferred" para manter sempre a ordem antiga.
ALYA_MODEL_ROUTING=smart
# Quantidade de mensagens recentes preservadas antes de resumir as antigas.
ALYA_CONTEXT_RECENT_MESSAGES=6
# Limite total aproximado de caracteres enviados como conversa.
ALYA_CONTEXT_MAX_CHARS=8000
# Respostas complexas podem usar um limite maior que MAX_TOKENS.
ALYA_COMPLEX_MAX_TOKENS=900
# Tempo máximo esperando o primeiro trecho de uma resposta em streaming.
ALYA_FIRST_TOKEN_TIMEOUT_MS=6500
# Tempo máximo para respostas comuns e tarefas complexas sem streaming.
ALYA_STANDARD_TIMEOUT_MS=10000
ALYA_COMPLEX_TIMEOUT_MS=18000
# Revisão seletiva de respostas técnicas/complexas com baixa qualidade.
ALYA_QUALITY_REVIEW=true
# Um provedor que falhar fica fora das próximas tentativas por este período.
ALYA_PROVIDER_FAILURE_COOLDOWN_MS=60000
# Modelos opcionais por tipo de tarefa no OpenRouter.
# OPENROUTER_FAST_MODEL=
# OPENROUTER_CODE_MODEL=
# OPENROUTER_REASONING_MODEL=
ALYA_CODE_PROVIDER=openrouter
ALYA_CODE_MAX_TOKENS=6000
ALYA_CODE_TIMEOUT_MS=18000
ALYA_CODE_HEDGE_DELAY_MS=2200
ALYA_CODE_HEDGE_MAX=2
# ALYA_CODE_FALLBACKS=openrouter,mistral,nvidia
# Quantidade de arquivos examinados e trechos relevantes enviados à Code Sofia.
ALYA_CODE_KNOWLEDGE_SCAN_LIMIT=80
ALYA_CODE_KNOWLEDGE_FILES=4
ALYA_CODE_KNOWLEDGE_MAX_CHARS=12000
MAX_TOKENS=500

# Acesso público sem login. Cada navegador recebe uma identidade privada e isolada.
AUTH_REQUIRED=false
# No computador local, libera a Code Sofia sem senha. No Render ela continua bloqueada.
ALLOW_LOCAL_ADMIN=true
# Mantém a identidade dos visitantes válida após reiniciar o servidor.
# Gere SESSION_SECRET com no mínimo 32 caracteres aleatórios.
SESSION_SECRET=gere_um_valor_longo_e_aleatorio_com_32_caracteres_ou_mais

# Contas ficam desativadas enquanto AUTH_REQUIRED=false.
# Se um dia quiser restaurar o login, use AUTH_REQUIRED=true.
# Administrador inicial do Render. ADMIN_PASSWORD_HASH deve ser um hash bcrypt,
# nunca a senha normal. Gere com: npm run criar-admin -- seu_usuario --render
# ADMIN_USERNAME=seu_usuario
# ADMIN_PASSWORD_HASH=$2b$12$cole_o_hash_gerado

# O cadastro público permanece desativado. Amigos são criados pelo terminal.

# Banco permanente (Postgres/Neon/Supabase/Render Postgres).
# Obrigatório no link público para contas, conversas, memórias e arquivos sobreviverem aos reinícios.
# DATABASE_URL=postgresql://usuario:senha@servidor:5432/banco
# DATABASE_SSL=true

# Origens extras permitidas, separadas por vírgula. Normalmente pode ficar vazio.
# CORS_ORIGIN=https://seu-dominio.com

# Opcao 2: Gemini
# Crie uma chave em https://aistudio.google.com/app/apikey
# AI_PROVIDER=gemini
# GEMINI_API_KEY=cole_sua_chave_aqui
# GEMINI_MODEL=gemini-2.5-flash
# ALYA_CODE_MODEL=gemini-3.5-flash

# Opcao 3: Groq (reserva gratuita, com limite diário do plano)
# GROQ_API_KEY=cole_sua_chave_aqui
# GROQ_MODEL=openai/gpt-oss-120b

# Opcao 4: NVIDIA (reserva gratuita, com limite do plano)
# Crie uma chave em https://build.nvidia.com/
# NVIDIA_API_KEY=cole_sua_chave_aqui
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Opcao 5: DeepSeek (última reserva; pode usar saldo da conta)
# DEEPSEEK_API_KEY=cole_sua_chave_aqui
# DEEPSEEK_MODEL=deepseek-v4-flash

# Opcao 6: Mistral (modo gratuito limitado)
# MISTRAL_API_KEY=cole_sua_chave_aqui
# MISTRAL_MODEL=mistral-small-latest

# Opcao 7: Cerebras (reserva gratuita, com limite do plano)
# CEREBRAS_API_KEY=cole_sua_chave_aqui
# CEREBRAS_MODEL=gpt-oss-120b

# Opcao 8: Together AI (reserva; pode exigir saldo da conta)
# TOGETHER_API_KEY=cole_sua_chave_aqui
# TOGETHER_MODEL=Qwen/Qwen3.5-9B

# Imagens no chat (a chave fica somente no servidor)
# Crie uma chave em https://enter.pollinations.ai/
# POLLINATIONS_API_KEY=cole_sua_chave_aqui
# POLLINATIONS_IMAGE_MODEL=flux

# Opcional: modelo que lê imagens anexadas
# MISTRAL_VISION_MODEL=mistral-small-latest

# Discord Bot (Opcional)
# Crie um bot em https://discord.com/developers/applications
# DISCORD_BOT_TOKEN=seu_token_aqui
# DISCORD_BOT_NAME=Sofia
# DISCORD_CLIENT_ID=seu_client_id_aqui
# DISCORD_ENABLED=true
# No Render, o bot fica ligado por padrão. Use false somente se quiser desligá-lo na nuvem.
# DISCORD_CLOUD_ENABLED=true
# DISCORD_APPROVAL_REQUIRED=false
# Opcional: apaga a mensagem original apenas dos usuários informados, após a resposta da Sofia.
# DISCORD_DELETE_USERNAMES=seu_nome_do_discord
# Somente este usuário conversa livremente com a Sofia no PV.
# Prefira o ID numérico, que não muda. O nome de usuário também é aceito.
# DISCORD_PRIVATE_OWNER_IDS=seu_id_numerico_do_discord
# DISCORD_PRIVATE_OWNER_USERNAME=seu_nome_do_discord

# Captura segura da tela pelo chat privado.
# O bot precisa estar no servidor e ter permissão para enviar arquivos nesses canais.
# Use apelido:id_do_canal e separe vários destinos por vírgula.
# DISCORD_SCREENSHOT_CHANNELS=global:123456789012345678,outro:987654321098765432
# No Render e no computador, coloque exatamente o mesmo segredo aleatório (mínimo 32 caracteres).
# ALYA_DEVICE_SECRET=gere_um_segredo_longo_e_aleatorio
# Somente no .env do computador: endereço da Sofia hospedada.
# ALYA_DEVICE_URL=https://seu-servico.onrender.com
# ALYA_DEVICE_ID=meu-pc

# Voz natural gratuita da Sofia no Discord (Microsoft Edge TTS)
# Não requer chave nem créditos. Precisa de internet para gerar a fala.
DISCORD_VOICE_ENABLED=true
DISCORD_VOICE_AUTO_REPLY=true
VOICE_PROVIDER=edge
EDGE_TTS_VOICE=pt-BR-ThalitaMultilingualNeural

# Opcional: voz premium da ElevenLabs
# VOICE_PROVIDER=elevenlabs
# ELEVENLABS_MODEL=eleven_v3
# ELEVENLABS_API_KEY=sua_chave_da_elevenlabs
# ELEVENLABS_API_KEY_NEW=sua_nova_chave_da_elevenlabs
# ELEVENLABS_VOICE_ID=id_da_voz_brasileira
