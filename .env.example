# Escolha uma das opcoes abaixo.
#
# Opcao 1: OpenRouter
# Crie uma chave em https://openrouter.ai/keys
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=cole_sua_chave_aqui
OPENROUTER_MODEL=openrouter/free
MAX_TOKENS=500

# Opcional: login para amigos entrarem quando a Astra estiver online.
# Formato: usuario:senha,usuario2:senha2
FRIEND_USERS=pedro:astra123,amigo:1234

# Se preferir uma senha unica sem usuarios, use SITE_PASSWORD e remova FRIEND_USERS.
# SITE_PASSWORD=astra123

# Opcao 2: Gemini
# Crie uma chave em https://aistudio.google.com/app/apikey
# AI_PROVIDER=gemini
# GEMINI_API_KEY=cole_sua_chave_aqui
# GEMINI_MODEL=gemini-2.5-flash
